  "cards": [
    {
      "dot": "emerald",
      "title": "Core journey",
      "items": [
        "1. Admin builds a form (Forms + builder)",
        "2. Pradhan intake creates the Pradhan user and a token assignment",
        "3. Admin shares /survey/[token] by hand (QR, WhatsApp)",
        "4. Voters fill the survey on their phone; answers saved to responses",
        "5. Reports workbench analyses responses per form"
      ]
    },
    {
      "dot": "rose",
      "title": "Roles and access",
      "items": [
        "super_admin: everything; only role that can delete users or change settings",
        "admin: only forms and Pradhans they created",
        "agent (Pradhan): cannot log in; uses the public token link only",
        "Proxy guards /dashboard/*; every API route re-checks the session"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data (MongoDB collections)",
      "items": [
        "users: admins and Pradhans (role, status, profile_data, profile %)",
        "forms: fields, prefill_from, status, soft delete (deleted_at)",
        "assignments: Pradhan + form + unique token, total_submissions",
        "responses: answers map, device, agent, submitted_at",
        "settings: global default intake form"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared building blocks",
      "items": [
        "DataTable + stateToMongo: one filter/sort/page format for UI and API",
        "useFetchJson: aborts stale requests, keeps rows while loading",
        "reportScope: shared form access + filter match for reports",
        "Settings: default intake form (super admin)"
      ]
    },
    {
      "dot": "amber",
      "title": "Known gaps on main",
      "items": [
        "No ownership check: GET /api/forms/[id], POST /api/forms/[id]/assign, GET /api/forms/[id]/assignments, GET /api/users/[id]/assignments",
        "/api/upload is public by design (type and size capped)",
        "/dev/data-table demo page ships to production"
      ]
    },
    {
      "dot": "slate",
      "title": "Keep this map current",
      "items": [
        "Update docs/app-map before every push to main",
        "Edit cipms-architecture.json, then re-run archify finalize",
        "Pin meta.repository.revision to the commit being pushed"
      ]
    }
  ]
}